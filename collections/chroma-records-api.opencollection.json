{
  "opencollection": "1.0.0",
  "info": {
    "name": "Chroma Cloud Collections Records API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Records",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Count records in a collection",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.trychroma.com/api/v2/tenants/:tenantName/databases/:databaseName/collections/:collectionId/count",
            "params": [
              {
                "name": "tenantName",
                "value": "",
                "type": "path",
                "description": "The name of the tenant"
              },
              {
                "name": "databaseName",
                "value": "",
                "type": "path",
                "description": "The name of the database"
              },
              {
                "name": "collectionId",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the collection"
              }
            ]
          },
          "docs": "Returns the number of records stored in the specified collection."
        },
        {
          "info": {
            "name": "Add records to a collection",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.trychroma.com/api/v2/tenants/:tenantName/databases/:databaseName/collections/:collectionId/add",
