              },
              {
                "name": "collectionId",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the collection"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Deletes records from the specified collection by IDs or metadata filter."
        },
        {
          "info": {
            "name": "Query records in a collection",
            "type": "http"
