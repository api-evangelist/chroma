                "description": "The name of the database"
              },
              {
                "name": "collectionId",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the collection"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Upserts records in the specified collection. If a record with the given ID already exists, it will be updated. If it does not exist, it will be created."
        },
        {
          "info": {
